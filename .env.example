# Copy this file to .env and fill in your real values. .env is gitignored.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
APP_PASSWORD=choose-a-password

# --- v2 model config (optional; verified defaults live in scout/config.py) ---
# Override only to survive a model rename — never hardcode IDs in code.
# ORCHESTRATOR_MODEL=claude-opus-4-8
# SUBAGENT_MODEL=claude-sonnet-4-6
# FAST_MODEL=claude-sonnet-4-6

# --- v2 guards (optional; §10) ---
# SCOUT_MAX_TURNS=40
# SCOUT_MAX_BUDGET_USD=3.0

# --- v2 monitoring email alerts (transactional API; only sends when all 3 are set) ---
# RESEND_API_KEY=your-resend-api-key
# SCOUT_ALERT_TO=you@example.com
# SCOUT_ALERT_FROM=Scout <onboarding@resend.dev>
